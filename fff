                ) : (
                  cart.map(item => (
                    <div key={item.id} className="flex items-center justify-between p-3 border rounded-2xl bg-slate-50">
                      <div className="flex items-center space-x-3">
                        <img src={item.image} alt={item.name} className="w-12 h-12 rounded-xl object-cover" />
                        <div>
                          <h4 className="text-xs font-bold text-slate-800 line-clamp-1">{item.name}</h4>
                          <span className="text-xs font-black text-[#00a651]">৳{item.price}</span>
                        </div>
                      </div>
                      <div className="flex items-center space-x-2 bg-white border px-2 py-1 rounded-xl">
                        <button onClick={() => updateCartQty(item.id, -1)} className="text-slate-500 hover:text-rose-600">
                          <Minus className="w-3 h-3" />
                        </button>
                        <span className="text-xs font-bold w-4 text-center">{item.qty}</span>
                        <button onClick={() => updateCartQty(item.id, 1)} className="text-slate-500 hover:text-[#00a651]">
                          <Plus className="w-3 h-3" />
                        </button>
                      </div>
                    </div>
                  ))
                )}
              </div>

              {cart.length > 0 && (
                <div className="p-4 border-t bg-slate-50 space-y-3">
                  <div className="flex justify-between text-sm font-bold">
                    <span>মোট প্রোডাক্ট মূল্য:</span>
                    <span className="text-[#00a651]">৳{cartTotal.toLocaleString()}</span>
                  </div>
                  <button
                    onClick={() => { setIsCartOpen(false); setIsCheckoutOpen(true); }}
                    className="w-full bg-[#00a651] hover:bg-emerald-700 text-white font-bold py-3 rounded-2xl text-xs shadow-lg transition"
                  >
                    অর্ডার করতে এগিয়ে যান (Checkout)
                  </button>
                </div>
              )}
            </div>
          </div>
        </div>
      )}

      {/* QUICK VIEW MODAL */}
      {quickViewProduct && (
        <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-xl w-full overflow-hidden shadow-2xl relative">
            <div className="absolute top-4 left-4 right-4 z-10 flex justify-between items-center pointer-events-none">
              <button
                onClick={() => setQuickViewProduct(null)}
                className="pointer-events-auto bg-slate-900/80 hover:bg-slate-900 text-white px-3 py-1.5 rounded-xl text-xs font-bold flex items-center space-x-1 shadow"
              >
                <ArrowLeft className="w-3.5 h-3.5" />
                <span>ব্যাক (Back)</span>
              </button>
              <button
                onClick={() => setQuickViewProduct(null)}
                className="pointer-events-auto bg-slate-100 p-2 rounded-full text-slate-600 hover:bg-slate-200 shadow"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2">
              <img src={quickViewProduct.image} alt={quickViewProduct.name} className="w-full h-64 md:h-full object-cover" />
              <div className="p-6 space-y-4 flex flex-col justify-between">
                <div>
                  <h2 className="text-base font-black text-slate-900">{quickViewProduct.name}</h2>
                  <p className="text-xs text-slate-500 mt-2 leading-relaxed">{quickViewProduct.description}</p>
                </div>
                <div>
                  <div className="text-xl font-black text-[#00a651] mb-4">৳{quickViewProduct.price}</div>
                  <button
                    onClick={() => { addToCart(quickViewProduct); setQuickViewProduct(null); }}
                    className="w-full bg-[#00a651] text-white py-3 rounded-2xl font-bold text-xs shadow-lg"
                  >
                    কার্টে যোগ করুন
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* CHECKOUT MODAL */}
      {isCheckoutOpen && (
        <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
              <button
                onClick={() => setIsCheckoutOpen(false)}
                className="text-xs font-bold text-slate-600 hover:text-slate-900 flex items-center space-x-1 bg-slate-100 px-2.5 py-1.5 rounded-lg"
              >
                <ArrowLeft className="w-4 h-4" />
                <span>ফিরে যান</span>
              </button>
              <h3 className="text-sm font-bold text-slate-900">অর্ডার নিশ্চিত করুন</h3>
              <button onClick={() => setIsCheckoutOpen(false)} className="text-slate-400"><X className="w-5 h-5" /></button>
            </div>

            <form onSubmit={handlePlaceOrder} className="space-y-3">
              <div>
                <label className="text-xs font-bold text-slate-700">আপনার নাম *</label>
                <input
                  type="text"
                  required
                  placeholder="যেমন: রহিম আহমেদ"
                  value={customerInfo.name}
                  onChange={(e) => setCustomerInfo({ ...customerInfo, name: e.target.value })}
                  className="w-full mt-1 px-3 py-2 border rounded-xl text-xs outline-none focus:border-[#00a651]"
                />
              </div>

              <div>
                <label className="text-xs font-bold text-slate-700">মোবাইল নম্বর *</label>
                <input
                  type="tel"
                  required
                  placeholder="017xxxxxxxx"
                  value={customerInfo.phone}
                  onChange={(e) => setCustomerInfo({ ...customerInfo, phone: e.target.value })}
                  className="w-full mt-1 px-3 py-2 border rounded-xl text-xs outline-none focus:border-[#00a651]"
                />
              </div>

              <div>
                <label className="text-xs font-bold text-slate-700">পূর্ণাঙ্গ ডেলিভারি ঠিকানা *</label>
                <textarea
                  required
                  rows="2"
                  placeholder="হাউজ নম্বর, রোড নম্বর, এলাকা..."
                  value={customerInfo.address}
                  onChange={(e) => setCustomerInfo({ ...customerInfo, address: e.target.value })}
                  className="w-full mt-1 px-3 py-2 border rounded-xl text-xs outline-none focus:border-[#00a651]"
                ></textarea>
              </div>

              <div>
                <label className="text-xs font-bold text-slate-700">জেলা</label>
                <select
                  value={customerInfo.district}
                  onChange={(e) => setCustomerInfo({ ...customerInfo, district: e.target.value })}
                  className="w-full mt-1 px-3 py-2 border rounded-xl text-xs outline-none bg-white"
                >
                  <option value="ঢাকা (Dhaka)">ঢাকার ভেতরে (ডেলিভারি চার্জ ৳৬০)</option>
                  <option value="ঢাকার বাইরে">ঢাকার বাইরে (ডেলিভারি চার্জ ৳১২০)</option>
                </select>
              </div>

              <div className="bg-slate-50 p-3 rounded-2xl space-y-1 text-xs">
                <div className="flex justify-between">
                  <span className="text-slate-500">প্রোডাক্ট মূল্য:</span>
                  <span className="font-bold">৳{cartTotal}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-slate-500">ডেলিভারি চার্জ:</span>
                  <span className="font-bold">৳{deliveryCharge}</span>
                </div>
                <div className="flex justify-between pt-1 border-t font-black text-slate-900">
                  <span>সর্বমোট:</span>
                  <span className="text-[#00a651]">৳{grandTotal}</span>
                </div>
              </div>

              <button
                type="submit"
                className="w-full bg-[#00a651] hover:bg-emerald-700 text-white font-bold py-3 rounded-2xl text-xs shadow-lg transition"
              >
                অর্ডার নিশ্চিত করুন (৳{grandTotal})
              </button>
            </form>
          </div>
        </div>
      )}

      {/* RESPONSIVE MOBILE BOTTOM NAVIGATION BAR */}
      <nav className="fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-slate-200 md:hidden px-2 py-1.5 flex justify-around items-center shadow-lg">
        <button
          onClick={handleResetToHome}
          className={`flex flex-col items-center p-1.5 rounded-xl text-[10px] font-bold ${
            viewMode === 'store' && selectedCategory === 'all' ? 'text-[#00a651]' : 'text-slate-500'
          }`}
        >
          <Home className="w-5 h-5 mb-0.5" />
          <span>হোম</span>
        </button>

        <button
          onClick={() => setIsMenuOpen(true)}
          className="flex flex-col items-center p-1.5 text-slate-500 rounded-xl text-[10px] font-bold"
        >
          <Menu className="w-5 h-5 mb-0.5" />
          <span>মেনু</span>
        </button>

        <button
          onClick={() => setIsCartOpen(true)}
          className="relative flex flex-col items-center p-1.5 text-slate-500 rounded-xl text-[10px] font-bold"
        >
          <ShoppingBag className="w-5 h-5 mb-0.5" />
          <span>কার্ট</span>
          {cartItemCount > 0 && (
            <span className="absolute top-0 right-2 bg-rose-600 text-white text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center">
              {cartItemCount}
            </span>
          )}
        </button>

        <button
          onClick={() => setViewMode('tracking')}
          className={`flex flex-col items-center p-1.5 rounded-xl text-[10px] font-bold ${
            viewMode === 'tracking' ? 'text-[#00a651]' : 'text-slate-500'
          }`}
        >
          <Truck className="w-5 h-5 mb-0.5" />
          <span>ট্র্যাকিং</span>
        </button>

        {viewMode !== 'store' ? (
          <button
            onClick={handleResetToHome}
            className="flex flex-col items-center p-1.5 rounded-xl text-[10px] font-bold text-rose-600"
          >
            <ArrowLeft className="w-5 h-5 mb-0.5" />
            <span>ব্যাক</span>
          </button>
        ) : (
          <button
            onClick={() => setViewMode('admin')}
            className="flex flex-col items-center p-1.5 rounded-xl text-[10px] font-bold text-amber-600"
          >
            <LayoutDashboard className="w-5 h-5 mb-0.5" />
            <span>এডমিন</span>
          </button>
        )}
      </nav>

    </div>
  );
}
